@startuml
' Roadmap de implementación (motivación + paquetes de trabajo)
' Editar y regenerar: `npm run diagrams` (ver docs/guias/diagramas.md)
!include <archimate/Archimate>
!theme archimate-standard from <archimate/themes>

title Roadmap de implementación del APM

skinparam defaultFontName "Helvetica, Arial, sans-serif"

' --- Motivación ---
Motivation_Goal(gConfiable, "Portafolio actualizado\ny confiable")
Motivation_Goal(gDecisiones, "Decisiones basadas\nen datos")
Motivation_Goal(gRiesgo, "Menor riesgo\n(seguridad y obsolescencia)")
Motivation_Goal(gIA, "IA segura con\nhumano en el bucle")
Motivation_Principle(pCodigo, "Arquitectura y docs\ncomo código")
Motivation_Principle(pIa, "La IA propone,\nla humana dispone")
Motivation_Principle(pTraza, "Trazabilidad total\nde cambios")

' --- Paquetes de trabajo ---
Implementation_WorkPackage(f0, "F0 · Cimientos\nportal de doc. y arquitectura")
Implementation_WorkPackage(f1, "F1 · Catálogo núcleo\nAplicaciones e Integraciones")
Implementation_WorkPackage(f2, "F2 · Tecnologías\nvulnerabilidades y obsolescencia")
Implementation_WorkPackage(f3, "F3 · Ingesta continua\nCMDB, nube, SBOM")
Implementation_WorkPackage(f4, "F4 · IA agéntica\nedición, arquitecturas, consulta")
Implementation_WorkPackage(f5, "F5 · Analítica avanzada\ny gobierno")

' --- Relaciones ---
Rel_Aggregation_Up(gConfiable, gDecisiones, "")
Rel_Aggregation_Up(gConfiable, gRiesgo, "")
Rel_Aggregation_Up(gConfiable, gIA, "")
Rel_Realization_Right(gConfiable, f5, "")
Rel_Realization_Right(gDecisiones, f5, "")
Rel_Realization_Right(gRiesgo, f2, "")
Rel_Realization_Right(gIA, f4, "")
Rel_Realization_Right(pTraza, f0, "")
Rel_Realization_Right(pCodigo, f0, "")
Rel_Realization_Right(pIa, f4, "")
Rel_Triggering_Right(f0, f1, "")
Rel_Triggering_Right(f1, f2, "")
Rel_Triggering_Right(f2, f3, "")
Rel_Triggering_Right(f3, f4, "")
Rel_Triggering_Right(f4, f5, "")
@enduml