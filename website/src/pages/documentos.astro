---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import documents from '../generated/pdfs.json';
---

<StarlightPage frontmatter={{ title: 'Documentos PDF', description: 'Documentos compartidos para las presentaciones de avance.' }}>
  <p>Archivos PDF publicados desde la carpeta <code>docs/</code>. Abre un documento para presentarlo o descarga una copia.</p>
  {documents.length === 0 && <p>Todavía no hay PDF publicados.</p>}
  {documents.map((document) => (
    <section>
      <h2>{document.title}</h2>
      <p>
        <a href={document.url} target="_blank" rel="noopener noreferrer">Abrir PDF en otra pestaña</a>
        {' · '}
        <a href={document.url} download>Descargar PDF</a>
      </p>
      <details>
        <summary>Ver documento aquí</summary>
        <div class="pdf-toolbar">
          <button type="button" data-fullscreen>Pantalla completa</button>
        </div>
        <iframe data-pdf src={document.url} title={`Vista previa: ${document.title}`} loading="lazy"></iframe>
        <p>Si tu navegador no muestra el PDF, utiliza el enlace para abrirlo o descargarlo.</p>
      </details>
    </section>
  ))}
</StarlightPage>

<style>
  section { margin-block: 2rem; }
  summary { cursor: pointer; padding-block: .75rem; }
  .pdf-toolbar { margin-block: .5rem; }
  .pdf-toolbar button {
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-4);
    color: var(--sl-color-text);
    padding: .35rem .9rem;
    border-radius: .4rem;
    cursor: pointer;
    font: inherit;
  }
  .pdf-toolbar button:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent); }
  iframe { width: 100%; height: 75vh; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; }
</style>

<script is:inline>
  document.querySelectorAll('[data-fullscreen]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = btn.closest('details')?.querySelector('[data-pdf]');
      if (!frame) return;
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else if (frame.requestFullscreen) {
        frame.requestFullscreen();
      }
    });
  });
</script>
