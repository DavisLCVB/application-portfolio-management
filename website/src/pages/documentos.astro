---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import documents from '../generated/pdfs.json';
---

<StarlightPage frontmatter={{ title: 'Documentos PDF', description: 'Documentos compartidos para las presentaciones de avance.' }}>
  <p>Archivos PDF publicados desde la carpeta <code>docs/</code>. Abre un documento para presentarlo o descarga una copia.</p>
  {documents.length === 0 && (
    <p>Todavía no hay PDF publicados. Mientras tanto, revisa la <a href="/arquitectura/">arquitectura del sistema</a> o la <a href="/presentaciones/">presentación de la propuesta</a>.</p>
  )}
  {documents.map((document) => (
    <section>
      <h2>{document.title}</h2>
      <div class="apm-acciones not-content">
        <a class="apm-btn apm-btn--primario" href={document.url} target="_blank" rel="noopener noreferrer">
          <span class="apm-ico apm-ico--externo" aria-hidden="true"></span>Abrir en otra pestaña
        </a>
        <a class="apm-btn apm-btn--secundario" href={document.url} download>
          <span class="apm-ico apm-ico--descargar" aria-hidden="true"></span>Descargar PDF
        </a>
      </div>
      <details>
        <summary>Ver documento aquí</summary>
        <div class="apm-acciones not-content">
          <button type="button" class="apm-btn apm-btn--secundario" data-fullscreen>
            <span class="apm-ico apm-ico--pantalla" aria-hidden="true"></span>Pantalla completa
          </button>
        </div>
        <iframe data-pdf src={document.url} title={`Vista previa: ${document.title}`} loading="lazy"></iframe>
        <p>Si tu navegador no muestra el PDF, utiliza el enlace para abrirlo o descargarlo.</p>
      </details>
    </section>
  ))}
</StarlightPage>

<style>
  section { margin-block: 2rem; }
  summary { cursor: pointer; padding-block: .75rem; }
  .apm-acciones { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block: 0.75rem; }
  iframe { width: 100%; height: 75vh; border: 0; border-radius: .5rem; box-shadow: var(--apm-ring); }
</style>

<script is:inline>
  document.querySelectorAll('[data-fullscreen]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = btn.closest('details')?.querySelector('[data-pdf]');
      if (!frame) return;
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else if (frame.requestFullscreen) {
        frame.requestFullscreen();
      }
    });
  });
</script>
