---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import presentations from '../generated/presentaciones.json';
---

<StarlightPage frontmatter={{ title: 'Presentaciones', description: 'Presentaciones de PowerPoint publicadas desde docs/.' }}>
  <p>Presentaciones de PowerPoint publicadas desde la carpeta <code>docs/</code>. Puedes verlas aquí o descargar una copia.</p>
  <p class="note">El visor de Office solo funciona en el dominio público de producción. En entornos locales o en despliegues de vista previa protegidos, descarga el archivo.</p>
  {presentations.length === 0 && (
    <p>Todavía no hay presentaciones publicadas. Mientras tanto, revisa la <a href="/arquitectura/">arquitectura del sistema</a>.</p>
  )}
  {presentations.map((presentation) => (
    <section class="apm-tile apm-pres not-content" data-presentation style="--tono-h: 275" aria-labelledby={`p-${presentation.url}`}>
      <div class="apm-pres__cab">
        <span class="apm-tile__icono"><span class="apm-ico apm-ico--presentaciones" aria-hidden="true"></span></span>
        <h2 id={`p-${presentation.url}`}>{presentation.title}</h2>
        <div class="apm-pres__acciones">
          <a class="apm-btn apm-btn--primario" href={presentation.url} download>
            <span class="apm-ico apm-ico--descargar" aria-hidden="true"></span>Descargar PPTX
          </a>
          <button type="button" class="apm-btn apm-btn--secundario" data-fullscreen>
            <span class="apm-ico apm-ico--pantalla" aria-hidden="true"></span>Pantalla completa
          </button>
        </div>
      </div>
      <iframe data-office data-src={presentation.url} title={`Presentación: ${presentation.title}`} loading="lazy" allowfullscreen></iframe>
      <p class="apm-pres__aviso" data-local-notice hidden>
        El visor de Office solo funciona en el sitio publicado. Usa <strong>Descargar PPTX</strong> para verla en este entorno.
      </p>
    </section>
  ))}
</StarlightPage>

<style>
  .note { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); }
  .apm-pres { gap: 1rem; margin-block: 2rem; }
  .apm-pres__cab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .apm-pres__cab h2 {
    flex: 1 1 12rem;
    font-size: var(--sl-text-h3);
  }
  .apm-pres__acciones { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  iframe {
    width: 100%;
    height: 75vh;
    border: 0;
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    box-shadow: var(--apm-ring);
  }
  .apm-pres__aviso {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--sl-color-black) 30%, transparent);
    box-shadow: var(--apm-ring);
  }
</style>

<script is:inline>
  // El visor de Office descarga el archivo desde su URL pública; en local no puede alcanzarlo.
  const isLocal = ['localhost', '127.0.0.1', '::1', '[::1]'].includes(location.hostname);
  document.querySelectorAll('[data-presentation]').forEach((section) => {
    const frame = section.querySelector('[data-office]');
    if (!frame) return;
    if (isLocal) {
      frame.remove();
      section.querySelector('[data-fullscreen]')?.remove();
      section.querySelector('[data-local-notice]')?.removeAttribute('hidden');
      return;
    }
    const fileUrl = new URL(frame.dataset.src, location.origin).href;
    frame.src = 'https://view.officeapps.live.com/op/embed.aspx?src=' + encodeURIComponent(fileUrl);
    section.querySelector('[data-fullscreen]')?.addEventListener('click', () => {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else if (frame.requestFullscreen) {
        frame.requestFullscreen();
      }
    });
  });
</script>
